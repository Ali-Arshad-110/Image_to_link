datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ImageUpload {
  id        String   @id @default(uuid())
  shortId   String   @unique
  fileName  String
  fileType  String
  s3Key     String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([shortId])
  @@index([expiresAt])
}
